From 3a25dc0a896714a740cce2ba6b6c9e0cf0b72910 Mon Sep 17 00:00:00 2001
From: Simon Wong <simonwong6944@gmail.com>
Date: Mon, 31 Aug 2026 06:07:19 +0000
Subject: [PATCH 1/2] feat: add migration 0032 - family tree members schema
 extension

Add 3 new columns to members table (all with DEFAULT, backward-compatible):
- member_type TEXT NOT NULL DEFAULT 'REGISTERED'  (REGISTERED | NODE_ONLY)
- managed_by  TEXT DEFAULT NULL                   (semantic FK to member_no)
- deceased_date TEXT DEFAULT NULL                 (YYYY-MM-DD, nullable)

Add 3 indexes:
- idx_members_member_type
- idx_members_managed_by
- idx_members_deceased_date

Applied to both local and production (coeldery85-db).
No existing endpoints, queries, or registration flow modified.
---
 migrations/0032_family_tree_members.sql | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)
 create mode 100644 migrations/0032_family_tree_members.sql

diff --git a/migrations/0032_family_tree_members.sql b/migrations/0032_family_tree_members.sql
new file mode 100644
index 0000000..d4c404e
--- /dev/null
+++ b/migrations/0032_family_tree_members.sql
@@ -0,0 +1,16 @@
+-- CoEldery85 × 家庭樹整合 — members 表擴充
+-- 全部 ADD COLUMN ... DEFAULT，向下相容，不動現有資料
+
+ALTER TABLE members ADD COLUMN member_type TEXT NOT NULL DEFAULT 'REGISTERED';
+-- REGISTERED = 正式會員（有 phone、可登入 APP）
+-- NODE_ONLY  = 純節點（先人／嬰兒／高齡代管）
+
+ALTER TABLE members ADD COLUMN managed_by TEXT DEFAULT NULL;
+-- NULL = 自行管理；CE85-XXXXXX = 代管人 member_no（語意 FK）
+
+ALTER TABLE members ADD COLUMN deceased_date TEXT DEFAULT NULL;
+-- 格式 YYYY-MM-DD；有值時應用層應同步 status = INACTIVE
+
+CREATE INDEX IF NOT EXISTS idx_members_member_type   ON members(member_type);
+CREATE INDEX IF NOT EXISTS idx_members_managed_by    ON members(managed_by);
+CREATE INDEX IF NOT EXISTS idx_members_deceased_date ON members(deceased_date);
-- 
